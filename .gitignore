__pycache__/
*.pyc
.pytest_cache/
dist/
build/
*.egg-info/
.venv/
.env
.superpowers/
data/eval/*.db*

# S7i acceptance run dir: the run's own store/trace are live evidence on disk, not repo source
data/eval/S7I-ACCEPTANCE/home/
data/eval/S7I-ACCEPTANCE/genesis-home/

# R1 research gate: bench binaries + stores stay local; results JSONs are the evidence
data/eval/R1-RESEARCH-2026-10-13/rerank-server/
data/eval/R1-RESEARCH-*/*.sqlite3*
data/eval/R1-GOLDEN-RAG-*/*.sqlite3*
data/eval/R1-SELECTCOMPOSE-*/*.sqlite3*
# R1-C5 runs: the verdict JSONs are the evidence; each ws/ is a ~61 MB scratch workspace
data/eval/R1-C5-*/ws/

# local scratch: debug/probe trace DBs at the repo root, captured pytest output, OS + tool files
/*_trace.sqlite3
pytest-output.txt
desktop.ini
.claude/

# Case material is never committed: each user supplies their own judgments,
# documents and eval runs (they stay on that machine only).
*.pdf
data/eval/
data/golden_cases/sources/*
!data/golden_cases/sources/README.md
