{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "model": "ollama-local/thomson1:latest",
  "small_model": "ollama-local/thomson1:latest",
  "provider": {
    "ollama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3.8:27b": {
          "name": "Qwen 3.8 27B (baseline parity model)",
          "limit": {
            "context": 32768,
            "output": 16384
          }
        },
        "thomson1:latest": {
          "name": "Thomson-1.0-Small (legal-domain comparison model)",
          "limit": {
            "context": 32768,
            "output": 16384
          }
        }
      }
    }
  }
}
